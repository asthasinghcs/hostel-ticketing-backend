DATABASE_PATH=/absolute/path/to/hostel_ticketing.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=5000

# Render uses the internal Postgres connection URL. Keep credentials out of Git.
# DATABASE_URL=postgresql://user:password@internal-host/database

# Neon CLI supplies both keys in ignored .env.local (or existing .env).
# DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/database?sslmode=require
